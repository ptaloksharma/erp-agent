# Azure Cloud Native target (no secrets here — Key Vault holds them)
# Replace with your vault URL after 'az keyvault create'
SECURI_KEYVAULT_URL=https://myvault.vault.azure.net/
# Replace with your Cosmos endpoint after 'az cosmosdb create'
SECURI_COSMOS_ENDPOINT=https://mycosmos.documents.azure.com:443/
SECURI_COSMOS_DB=securi
SECURI_COSMOS_CONTAINER=checkpoints
DM_ENV=production
